{
  "name": "badthingsforpets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint -c .oxlintrc.json apps packages infra data",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt '**/*.{ts,tsx,js,mjs}' --ignore-path .gitignore",
    "format:check": "oxfmt --check '**/*.{ts,tsx,js,mjs}' --ignore-path .gitignore",
    "seed:local": "pnpm --filter @btfp/seed run seed:local",
    "cdk": "pnpm --filter @btfp/infra run cdk",
    "secrets:push": "pnpm --filter @btfp/infra run secrets:push",
    "secrets:sync": "pnpm --filter @btfp/infra run secrets:sync",
    "prepare": "lefthook install",
    "mycota:pull": "bash scripts/mycota-pull.sh"
  },
  "devDependencies": {
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  }
}
