{
  "metadata": {
    "title": "Dog breed roster with physical-trait tags for breed-aware advice",
    "compiled": "2026-08-03",
    "compiled_by": "Breed roster: AKC breed list via kkakey/dog_traits_AKC (https://github.com/kkakey/dog_traits_AKC), reformatted from AKC's group-page names into standard breed names. Trait tags manually compiled from veterinary/AKC sources — see docs/data-sourcing.md for the per-trait citation list. Not every breed has a tagged trait; an empty traits array just means none of the five curated categories apply.",
    "traitDefinitions": {
      "long-backed": "Chondrodystrophic body shape (short legs relative to a long spine) — elevated IVDD/disc-herniation risk from stairs, jumping, and rough play.",
      "brachycephalic": "Flat-faced/short-muzzled — elevated heat-intolerance and breathing-obstruction risk, especially with exertion or heat.",
      "giant-breed": "Very large adult size — elevated risk from joint/bone strain, faster growth-plate issues in puppies, and shorter lifespan considerations.",
      "deep-chested": "Deep, narrow chest conformation — elevated bloat/GDV (gastric dilatation-volvulus) risk, especially after large meals or exercise soon after eating.",
      "toy-breed": "Very small adult size — elevated risk from falls/being stepped on, hypoglycemia, and dental crowding."
    }
  },
